# ==============================================================================
# GRYPHON Phase 1 — environment configuration example
# ==============================================================================
# Copy to `.env` and fill in. NEVER commit a real `.env`.
#
# Contract notes:
#   * §19.4 / SEC-004: in `prod`, missing/invalid key material FAILS READINESS.
#     No ephemeral production key is ever generated (§28.1).
#   * SEC-014 / INV-019: the grant-signing key and the audit-signing key MUST be
#     distinct. Startup rejects identical key fingerprints.
#   * §21.2 / §24.3: these secrets MUST NOT appear in logs, metrics or audit rows.
# Generate a fresh, valid key set with:  python -m scripts.generate_keys
# ==============================================================================

# ---- Deployment profile: dev | test | prod ----------------------------------
GRYPHON_ENVIRONMENT=dev

# ---- Issuer / audience policy (§11.1) ---------------------------------------
GRYPHON_ISSUER=gryphon-local-operator
GRYPHON_AUDIENCE=gryphon-authorization-service

# ---- Grant signing key (Ed25519 private key, 32-byte raw, hex) ---------------
# Operator-controlled. Used ONLY by the local issuance path (BND-01).
GRYPHON_GRANT_SIGNING_KEY_HEX=
GRYPHON_GRANT_KID=grant-key-2026-01

# ---- Grant trusted public keys (kid -> 32-byte raw Ed25519 public key, hex) --
# JSON object. The verifier trusts ONLY these keys (SEC-002). A token cannot
# add a key or choose a remote key URL.
GRYPHON_GRANT_TRUSTED_PUBLIC_KEYS={"grant-key-2026-01": ""}

# ---- Audit signing key (DISTINCT Ed25519 key, 32-byte raw, hex) -------------
GRYPHON_AUDIT_SIGNING_KEY_HEX=
GRYPHON_AUDIT_KID=audit-key-2026-01
GRYPHON_AUDIT_TRUSTED_PUBLIC_KEYS={"audit-key-2026-01": ""}

# ---- Clock skew allowance (seconds) -----------------------------------------
# Bounded deployment value; NEVER extends `exp` (§11.2).
GRYPHON_CLOCK_SKEW_SECONDS=60

# ---- Database: runtime (restricted) role DSN --------------------------------
# Least-privilege role. Cannot own schema; cannot UPDATE/DELETE/TRUNCATE audit.
GRYPHON_DATABASE_URL=postgresql+asyncpg://gryphon_runtime:runtime_pw@localhost:5432/gryphon

# ---- Database: migration (owner) role DSN -----------------------------------
# Separate deploy identity used by Alembic only (§22.3). Leave blank in runtime.
GRYPHON_MIGRATION_DATABASE_URL=postgresql+asyncpg://gryphon_owner:owner_pw@localhost:5432/gryphon

# ---- Bounded deadlines (seconds) — finite and tested (§16) -------------------
GRYPHON_DB_CONNECT_TIMEOUT_SECONDS=5
GRYPHON_DB_STATEMENT_TIMEOUT_SECONDS=10
GRYPHON_REQUEST_DEADLINE_SECONDS=15
GRYPHON_DB_MAX_RETRIES=2

# ---- Redis (provisioned ONLY; never authorization truth — INV-021) ----------
GRYPHON_REDIS_URL=redis://localhost:6379/0

# ==============================================================================
# Tool execution layer configuration
# ==============================================================================
# Capability signing key (Ed25519, 32-byte raw hex) — MUST be distinct from the
# grant and audit keys. Startup rejects a non-distinct key.
GRYPHON_CAPABILITY_SIGNING_KEY_HEX=
GRYPHON_CAPABILITY_KID=capability-key-2026-01
GRYPHON_CAPABILITY_TRUSTED_PUBLIC_KEYS={"capability-key-2026-01": ""}

# Capability lifetime (short) and bounded cross-process clock skew (seconds).
GRYPHON_CAPABILITY_TTL_SECONDS=120
GRYPHON_CAPABILITY_CLOCK_SKEW_SECONDS=30

# OS egress containment: 'enforced' (default) creates a per-execution Linux
# network namespace with a default-deny nftables egress allowlist, or the tool
# fails closed. 'unenforced' is dev/single-tenant only and needs
# GRYPHON_ALLOW_UNENFORCED_EGRESS=true; it is prohibited in prod.
# Requires Linux. 'prod' on a non-Linux host is refused at startup.
GRYPHON_EGRESS_MODE=enforced
GRYPHON_ALLOW_UNENFORCED_EGRESS=false

# Privileged egress helper. When set, the application runs UNPRIVILEGED and this
# executable performs the namespace + nftables setup (install it with a narrow
# sudoers entry, a systemd unit, or file capabilities). When unset, the process
# itself must hold CAP_NET_ADMIN.
#   GRYPHON_EGRESS_HELPER_PATH=/opt/gryphon/bin/gryphon-egress-helper
GRYPHON_EGRESS_HELPER_PATH=

# Subprocess bounds. The memory ceiling is applied with setrlimit(RLIMIT_AS) in
# the child and requires POSIX; core dumps are disabled unconditionally there.
GRYPHON_SUBPROCESS_DEFAULT_TIMEOUT_SECONDS=120
GRYPHON_SUBPROCESS_MEMORY_LIMIT_MB=1024

# Aggregate budgets (per host and per scan_run_id).
GRYPHON_MAX_HOST_CONCURRENT_EXECUTIONS=16
GRYPHON_PER_RUN_MAX_CONCURRENT=8
GRYPHON_PER_RUN_RATE_PER_SECOND=5.0
GRYPHON_PER_RUN_BURST=10

# Pinned-binary provisioning (absolute paths + checksums; never @latest).
GRYPHON_TOOL_BIN_DIR=
GRYPHON_TOOL_MANIFEST_PATH=
GRYPHON_NUCLEI_TEMPLATES_DIR=

# =============================================================================
# Scan orchestration layer
# =============================================================================
# The pipeline that composes enforced tool calls into one authorized scan.
# Adds no new dependency. Every bound below is finite and validated at startup.

# ---- Fenced lease and recovery ----------------------------------------------
# The lease makes an abandoned scan reclaimable; the monotonic claim epoch
# stamped on every write makes a superseded owner's writes impossible. The
# heartbeat MUST be shorter than half the lease, or one missed beat hands the
# scan to a second owner. TO BE MEASURED against real scan durations.
GRYPHON_SCAN_LEASE_SECONDS=60
GRYPHON_SCAN_HEARTBEAT_SECONDS=15
# The sweeper reclaims abandoned scans and retires overdue ones on this
# interval. Must not exceed the lease, or abandoned work outlives it unobserved.
GRYPHON_SWEEPER_INTERVAL_SECONDS=30
# How long an indeterminate outcome may stay indeterminate before it is
# terminally classified as possibly-contacted. Bounds reconciliation so an
# unresolvable uncertainty cannot stall a scan forever.
GRYPHON_RECONCILIATION_WINDOW_SECONDS=900

# ---- Deadlines and budgets --------------------------------------------------
# An operator ceiling on scan wall time. The EFFECTIVE deadline is
# min(this, grant expiry - the call's own hard deadline): the grant always wins,
# so a scan cannot outrun its authorization.
GRYPHON_SCAN_DEADLINE_SECONDS=21600
GRYPHON_MAX_ATTEMPTS_PER_ITEM=2
# Global ceiling on enforcement-layer decisions. Each one costs a signed audit
# row, so this stops a flapping target flooding the append-only audit.
GRYPHON_MAX_DECISIONS_PER_SCAN=20000
# After a saturation or breaker-open outcome, stop calling rather than retrying
# into a wall.
GRYPHON_BREAKER_COOLDOWN_SECONDS=60
# In-flight dispatches within one step. Subordinate to the enforcement layer's
# own aggregate budgets, which remain authoritative.
GRYPHON_MAX_STEP_CONCURRENCY=4

# ---- Target admission -------------------------------------------------------
# Above this many discovered targets the scan halts for operator review instead
# of fanning out. Discovery output is attacker-influenceable.
GRYPHON_DISCOVERED_TARGET_CAP=2000
# The operator-confirmed estate. Scope is granted over NAMES; containment is
# enforced over ADDRESSES. A dangling subdomain under a wildcard grant is in
# scope by name while pointing at a stranger's host, so a discovered target is
# actively scanned only if its resolved address attests to this list.
# REQUIRED in prod. Empty + strict = discovered targets are not actively scanned.
GRYPHON_ATTESTED_ESTATE_CIDRS=
GRYPHON_STRICT_ADDRESS_ATTESTATION=true

# ---- Completion -------------------------------------------------------------
# Covered fraction below which a finished scan is FAILED rather than
# COMPLETED_WITH_GAPS. "Most of the scan did not happen" is not a completion.
GRYPHON_COVERAGE_FAILURE_FLOOR=0.5

# ---- Invocation surface -----------------------------------------------------
# This layer turns a bare scan id into live scanning authority, so the caller is
# authenticated by kernel-reported peer credentials, never a self-asserted
# value. REQUIRED in prod; the CLI path (real uid) is permitted elsewhere.
GRYPHON_CONTROL_SOCKET_PATH=
GRYPHON_CONTROL_ALLOWED_UIDS=

# ---- Control-plane containment ----------------------------------------------
# This process holds the live authorization, so it runs under a default-deny
# egress policy permitting the database only. Declared here; enforced by
# deployment with the same OS mechanism the tool layer already uses.
GRYPHON_REQUIRE_CONTROL_PLANE_EGRESS_DENY=true

# NOTE: third-party tracing is refused at startup. The graph runtime pulls in a
# tracing client transitively that activates from the environment alone, and its
# payloads would be node inputs and outputs -- client hostnames, discovered
# attack surface, findings -- leaving the process that holds the permit. Do NOT
# set LANGSMITH_TRACING, LANGSMITH_API_KEY, LANGCHAIN_TRACING_V2 or similar.

# =============================================================================
# Enrichment layer
# =============================================================================
# Turns a finished scan's VERIFIED evidence into an explainable priority using
# public intelligence acquired whole (CISA KEV catalog, FIRST EPSS daily file)
# and pinned, offline ATT&CK reference data. Adds no new runtime dependency.
# Every security-relevant bound is a code constant; settings may only NARROW.

# ---- Dedicated database role ------------------------------------------------
# The enrichment process connects as its own role: SELECT on the evidence and the
# attested report, INSERT on enrichment tables, column-scoped UPDATE on its two
# lifecycle rows, and nothing else. REQUIRED (dedicated role) in prod.
GRYPHON_ENRICHMENT_DATABASE_URL=postgresql+asyncpg://gryphon_enrichment:enrichment_pw@localhost:5432/gryphon

# ---- Attestation key (dedicated purpose) ------------------------------------
# Signs enrichment reports and snapshot acceptances only. Must share neither kid
# nor key with the grant, audit or capability keys (refused at startup).
# Generate with: python -m scripts.generate_keys
GRYPHON_ENRICHMENT_SIGNING_KEY_HEX=
GRYPHON_ENRICHMENT_KID=enrichment-key-2026-01
GRYPHON_ENRICHMENT_TRUSTED_PUBLIC_KEYS={"enrichment-key-2026-01": ""}

# ---- Storage ----------------------------------------------------------------
# Content-addressed accepted snapshots (raw, normalized, metadata). Do not prune
# KEV artifacts younger than the 7-day removal-hold window.
GRYPHON_ENRICHMENT_ARTIFACT_DIR=var/enrichment/artifacts
# Pinned ATT&CK reference data. Provision with:
#   python -m scripts.provision_reference_data --download
GRYPHON_ENRICHMENT_REFERENCE_DIR=var/enrichment/reference
# Optional override of the packaged priority policy. Any edit is a new policy
# digest, recorded on every derived priority.
# GRYPHON_ENRICHMENT_POLICY_PATH=
# Digest of the nuclei template set that produced the evidence, once pinned.
# Unset: CVSS assertions are labelled TEMPLATES:unpinned.
# GRYPHON_ENRICHMENT_TEMPLATES_DIGEST=

# ---- Acquisition (narrow-only) ----------------------------------------------
# Hosts may only be REMOVED from the built-in list (www.cisa.gov,
# epss.empiricalsecurity.com). Acquisition runs as a separate process inside the
# OS egress enforcer (GRYPHON_EGRESS_MODE above) with no DB, keys or engagement data.
# GRYPHON_ENRICHMENT_ALLOWED_HOSTS=["www.cisa.gov","epss.empiricalsecurity.com"]
GRYPHON_ENRICHMENT_CONNECT_TIMEOUT_SECONDS=10
GRYPHON_ENRICHMENT_REQUEST_TIMEOUT_SECONDS=120
GRYPHON_ENRICHMENT_SUBPROCESS_TIMEOUT_SECONDS=300
GRYPHON_ENRICHMENT_FETCH_ATTEMPTS=3

# ---- Freshness and breaker --------------------------------------------------
# A failed refresh writes nothing; the newest accepted snapshot simply ages and
# passes report ENRICHED_STALE past these bounds. Capped at 7 days.
GRYPHON_ENRICHMENT_KEV_MAX_AGE_HOURS=24
GRYPHON_ENRICHMENT_EPSS_MAX_AGE_HOURS=48
GRYPHON_ENRICHMENT_BREAKER_FAILURES=3
GRYPHON_ENRICHMENT_BREAKER_COOLDOWN_SECONDS=3600

# ---- Pass lease -------------------------------------------------------------
# One system-wide slot; the lease is evaluated on the database clock and must
# cover at least two heartbeats.
GRYPHON_ENRICHMENT_PASS_LEASE_SECONDS=60
GRYPHON_ENRICHMENT_PASS_HEARTBEAT_SECONDS=15

# ---- Callers ----------------------------------------------------------------
# Real uids permitted to run enrichment commands. REQUIRED in prod.
GRYPHON_ENRICHMENT_ALLOWED_UIDS=[]

# =============================================================================
# Verification layer
# =============================================================================
# Re-observes a finished scan's findings through the tool execution gateway and
# publishes an attested verdict per finding. This process holds no HTTP client
# and no resolver: its only sockets are the database and the gateway.
#
# These settings are STRICT. An unknown GRYPHON_VERIFICATION_* name is a startup
# refusal, not an ignored extra: a typo in a security variable would otherwise
# leave its permissive default silently in force. Every security-relevant bound
# is a code constant; settings may only NARROW.

# ---- Dedicated database role ------------------------------------------------
# SELECT on the evidence and the attested reports, INSERT on its own append-only
# tables, column-scoped UPDATE on its own lifecycle columns, and nothing else.
# No process holds a second database identity. REQUIRED (dedicated role) in prod.
GRYPHON_VERIFICATION_DATABASE_URL=postgresql+asyncpg://gryphon_verification:verification_pw@localhost:5432/gryphon

# ---- Attestation key (dedicated purpose) ------------------------------------
# Signs verification reports and signed events only. Must share neither kid nor
# key with any other purpose (refused at startup).
# Generate with: python -m scripts.generate_keys
GRYPHON_VERIFICATION_SIGNING_KEY_HEX=
GRYPHON_VERIFICATION_KID=verification-key-2026-01
GRYPHON_VERIFICATION_TRUSTED_PUBLIC_KEYS={"verification-key-2026-01": ""}

# ---- Policy trust (a key this process must NOT hold) ------------------------
# The verifier registry and its pinned provider list are reviewed and signed in
# operator custody. A digest is integrity; a signature from a key this process
# cannot produce is what makes the registry an authority. REQUIRED in prod.
GRYPHON_VERIFICATION_POLICY_SIGNING_TRUSTED_KEYS={}

# ---- Verifier registry ------------------------------------------------------
# Unset uses the packaged registry document. Any change is a new digest, and the
# digest is pinned per pass. A signature is REQUIRED in prod.
# GRYPHON_VERIFICATION_REGISTRY_PATH=
GRYPHON_VERIFICATION_REQUIRE_SIGNED_REGISTRY=false

# ---- Gateway (the only outward socket) --------------------------------------
# Unix socket of gryphon-gatewayd, so the peer's uid is checkable on the
# kernel's word. REQUIRED: there is no other path to an observation.
GRYPHON_VERIFICATION_GATEWAY_SOCKET_PATH=
GRYPHON_VERIFICATION_GATEWAY_CONNECT_TIMEOUT_SECONDS=5

# ---- Budgets (narrow-only) --------------------------------------------------
# Lowering any of these is always allowed; raising one past its ceiling is a
# startup refusal. Exhaustion is reported as INCONCLUSIVE(budget_exhausted) on
# the lowest-priority remainder, never hidden.
GRYPHON_VERIFICATION_FINDINGS_PER_PASS=2000
GRYPHON_VERIFICATION_OBSERVATIONS_PER_PASS=6000
GRYPHON_VERIFICATION_CONCURRENCY=4
GRYPHON_VERIFICATION_PASS_DEADLINE_SECONDS=3600
# Controls are extra requests to someone else's host; this caps how many one
# host absorbs in a pass. A reduced control count is recorded on the verdict.
GRYPHON_VERIFICATION_CONTROLS_PER_HOST=100

# ---- Pass lease -------------------------------------------------------------
# One open pass per scan; the lease is evaluated on the database clock and must
# cover at least two heartbeats.
GRYPHON_VERIFICATION_PASS_LEASE_SECONDS=60
GRYPHON_VERIFICATION_PASS_HEARTBEAT_SECONDS=15

# ---- Pinned destination facts ----------------------------------------------
# Digest of the estate attestation applied when a pass pins its inputs.
# GRYPHON_VERIFICATION_ESTATE_DIGEST=
# Resolvers a resolver-mediated observation may use, pinned explicitly: a
# resolver answering for a name the operator did not choose can turn a dangling
# record check into a false negative. Unset reports resolver_set_digest=unpinned.
GRYPHON_VERIFICATION_RESOLVER_SET=[]

# ---- Egress posture ---------------------------------------------------------
# Declared posture; readiness derives the effective one from observed facts.
# Prod refuses "unenforced".
GRYPHON_VERIFICATION_EGRESS_POSTURE=enforced

# ---- Enrichment context (optional, never required) --------------------------
# With context off, a pass records ordering_basis=observed_severity and the
# report states that prioritisation did not use exploitation intelligence. A
# superseded enrichment report never abandons traffic-bearing work.
GRYPHON_VERIFICATION_USE_ENRICHMENT_CONTEXT=true
GRYPHON_VERIFICATION_USE_SUPERSEDED_ENRICHMENT=true
# Read-only trust: this process verifies enrichment reports and signs none.
GRYPHON_VERIFICATION_ENRICHMENT_TRUSTED_PUBLIC_KEYS={}

# ---- Callers ----------------------------------------------------------------
# Real uids permitted to run verification commands. REQUIRED in prod.
GRYPHON_VERIFICATION_ALLOWED_UIDS=[]
